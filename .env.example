# YouTube Data API v3 (GCP Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit OAuth2 (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=UniverseLovesMe/1.0 by u/your_username

# SerpApi (https://serpapi.com/)
SERPAPI_KEY=your_serpapi_key_here

# Apify (https://apify.com/)
APIFY_TOKEN=your_apify_token_here

# ListenNotes (https://www.listennotes.com/api/)
LISTENNOTES_KEY=your_listennotes_key_here

# Apollo.io (https://apollo.io/)
APOLLO_KEY=your_apollo_key_here

# Anthropic / Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hunter.io (https://hunter.io/)
HUNTER_KEY=your_hunter_key_here

# Instantly.ai (https://instantly.ai/)
INSTANTLY_KEY=your_instantly_key_here

# Airtable (https://airtable.com/create/tokens)
AIRTABLE_PAT=your_airtable_pat_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Notification (for positive reply alerts) — pick one
NOTIFY_EMAIL=your_email@example.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
