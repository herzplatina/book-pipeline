# YouTube Data API v3 (GCP Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit — Arctic Shift is used for discovery; no Reddit credentials required.

# SerpApi (https://serpapi.com/)
SERPAPI_KEY=your_serpapi_key_here

# Apify (paused for now; revisit later)
# APIFY_TOKEN=your_apify_token_here

# ListenNotes (https://www.listennotes.com/api/)
LISTENNOTES_KEY=your_listennotes_key_here

# Apollo.io (paused for now)
# APOLLO_KEY=your_apollo_key_here

# Anthropic / Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hunter.io (https://hunter.io/)
HUNTER_KEY=your_hunter_key_here

# Hunter Sequence — same HUNTER_KEY credential, one sequence for all automated outreach
HUNTER_SEQUENCE_ID=your_hunter_sequence_id_here

# Airtable (https://airtable.com/create/tokens)
AIRTABLE_PAT=your_airtable_pat_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Open/reply notifications are recorded in Airtable by the Hunter webhook.
# Add Airtable automations/views later if you want push alerts.

# Webhook authentication — set a strong random secret and configure it in Hunter
# with the /webhook/hunter endpoint. Required; webhook rejects requests without it.
WEBHOOK_SECRET=generate_with__python3_-c__import_secrets_print_secrets.token_hex_32__
